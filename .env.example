# Copy this file to .env and fill in the values from your Aiven service. NEVER upload .env to GitHub.
# Aiven Console -> your MySQL service -> Overview -> Service URI
DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@YOUR_HOST.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
# Optional (safer): download ca.pem from the same page, save it in this folder, and uncomment:
# DB_CA_CERT=ca.pem
